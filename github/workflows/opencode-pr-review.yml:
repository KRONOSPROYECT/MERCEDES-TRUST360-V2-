name: TRUST 2099 - OpenCode PR Review
on:
  pull_request:
    types: [opened, synchronize]
  push:
    branches: [main]

jobs:
  review:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: TRUST 2099 Guardian Review
        run: |
          echo "🔍 Revisando por Marco Antonio Rojas Valdovinos..."
          echo "✅ Verificando index.html existe"
          if [ -f "index.html" ]; then echo "✅ index.html OK"; else echo "❌ Falta index.html"; exit 1; fi
          echo "✅ Verificando WhatsApp 527225862335"
          if grep -q "527225862335" index.html; then echo "✅ WhatsApp correcto"; else echo "⚠️ WhatsApp no encontrado"; fi
          echo "✅ Verificando firma TRUST 2099"
          if grep -q "ROJAS VALDOVINOS" index.html; then echo "✅ Firma intacta"; else echo "❌ Firma borrada"; exit 1; fi
          echo "✅ TRUST 2099 VERIFIED - Embajada Digital OK"
