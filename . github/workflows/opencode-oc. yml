name: TRUST 2099 - OC Command
on:
  issue_comment:
    types: [created]
  issues:
    types: [opened, labeled]

jobs:
  oc:
    if: contains(github.event.comment.body, '/oc') || contains(github.event.issue.body, '/oc') || contains(toJson(github.event.label.name), 'agent-fix')
    runs-on: ubuntu-latest
    permissions:
      contents: write
      pull-requests: write
      issues: write
    steps:
      - uses: actions/checkout@v4
      - uses: anomalyco/opencode/github@latest
        with:
          github_token: ${{ secrets.GITHUB_TOKEN }}
